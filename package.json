{
  "name": "@coela/learning-site",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "content": "node --experimental-strip-types scripts/prepare.mts",
    "test": "node --test tests/*.test.mts",
    "typecheck": "pnpm content && tsc -p tsconfig.tools.json && nuxt typecheck",
    "generate": "pnpm content && nuxt generate && node scripts/check-output.mts",
    "dev": "pnpm content && nuxt dev --host 127.0.0.1",
    "review": "node scripts/review.mts",
    "observe": "node scripts/collect.mts",
    "observe:status": "node scripts/observation-state.mts status",
    "observe:remove": "node scripts/observation-state.mts remove"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxtjp/dependency-security": "0.2.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  },
  "license": "MIT"
}
